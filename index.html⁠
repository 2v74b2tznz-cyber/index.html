<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>متجر طلال</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        body { background-color: #f4f7f6; color: #333; }
        
        /* Header */
        header { background: #1a252f; color: white; padding: 1rem 2rem; display: flex; justify-content: space-between; align-items: center; }
        .logo { font-size: 1.5rem; font-weight: bold; color: #2ecc71; }
        .cart-icon { cursor: pointer; position: relative; font-size: 1.2rem; }
        .cart-count { background: #e74c3c; color: white; border-radius: 50%; padding: 2px 6px; font-size: 0.8rem; position: absolute; top: -8px; right: -10px; }

        /* Main Content */
        .container { max-width: 1200px; margin: 2rem auto; padding: 0 1rem; }
        .hero { text-align: center; margin-bottom: 3rem; }
        .hero h1 { font-size: 2.5rem; margin-bottom: 0.5rem; }
        
        /* Products Grid */
        .products-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem; }
        .product-card { background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.1); text-align: center; padding-bottom: 1rem; }
        .product-card img { width: 100%; height: 200px; object-fit: cover; }
        .product-title { font-size: 1.2rem; margin: 0.5rem 0; }
        .product-price { color: #2ecc71; font-weight: bold; margin-bottom: 1rem; }
        .btn-add { background: #2ecc71; color: white; border: none; padding: 0.5rem 1rem; border-radius: 4px; cursor: pointer; font-size: 1rem; }
        .btn-add:hover { background: #27ae60; }

        /* Footer */
        footer { text-align: center; padding: 1.5rem; background: #1a252f; color: white; margin-top: 3rem; }
    </style>
</head>
<body>

    <header>
        <div class="logo">متجر طلال</div>
        <div class="cart-icon">
            🛒 السلة <span class="cart-count" id="cart-count">0</span>
        </div>
    </header>

    <div class="container">
        <section class="hero">
            <h1>أهلاً بك في متجرنا</h1>
            <p>تسوق أفضل المنتجات بأفضل الأسعار</p>
        </section>

        <main class="products-grid">
            <!-- منتج 1 -->
            <div class="product-card">
                <img src="https://via.placeholder.com/250" alt="منتج 1">
                <h3 class="product-title">منتج مميز 1</h3>
                <p class="product-price">150 ر.س</p>
                <button class="btn-add" onclick="addToCart()">إضافة للسلة</button>
            </div>

            <!-- منتج 2 -->
            <div class="product-card">
                <img src="https://via.placeholder.com/250" alt="منتج 2">
                <h3 class="product-title">منتج مميز 2</h3>
                <p class="product-price">200 ر.س</p>
                <button class="btn-add" onclick="addToCart()">إضافة للسلة</button>
            </div>

            <!-- منتج 3 -->
            <div class="product-card">
                <img src="https://via.placeholder.com/250" alt="منتج 3">
                <h3 class="product-title">منتج مميز 3</h3>
                <p class="product-price">99 ر.س</p>
                <button class="btn-add" onclick="addToCart()">إضافة للسلة</button>
            </div>
        </main>
    </div>

    <footer>
        <p>&copy; 2026 جميع الحقوق محفوظة لـ متجر طلال</p>
    </footer>

    <script>
        let count = 0;
        function addToCart() {
            count++;
            document.getElementById('cart-count').innerText = count;
            alert('تمت إضافة المنتج إلى السلة!');
        }
    </script>
</body>
</html>
